# converts a gif image to a mp4 video
gif2video() {
  ffmpeg -f gif -i "$1" gif2video.mp4;
}

# converts a video to a high-quality gif image
# usage: video2gif input.mov [fps] [width]   (defaults: 15 fps, original size)
video2gif() {
  local input="$1"
  local fps="${2:-15}"
  local width="$3"
  local output="${input%.*}.gif"
  local palette="$(mktemp -t palette).png"
  local filters="fps=${fps}"
  [ -n "$width" ] && filters="${filters},scale=${width}:-1:flags=lanczos"

  # pass 1: build an optimal per-video color palette
  ffmpeg -i "$input" -vf "${filters},palettegen=stats_mode=diff" -y "$palette" &&
  # pass 2: render the gif using that palette with dithering
  ffmpeg -i "$input" -i "$palette" \
    -lavfi "${filters} [x]; [x][1:v] paletteuse=dither=sierra2_4a" \
    -y "$output" &&
  gifsicle -O3 "$output" -o "$output" &&
  rm -f "$palette";
}

# makes a directory and cds inside
mkcd () {
  \mkdir -p "$1"
  cd "$1"
}

# get notified when the previous command finishes
notify() {
  # Gets the last command from history, stripping the leading line numbers
  local last_cmd=$(fc -ln -1 -1)
  
  # Escape double quotes to prevent AppleScript syntax syntax breaks
  last_cmd=$(echo "$last_cmd" | sed 's/"/\\"/g')

  osascript -e "display notification \"$last_cmd\" with title \"Task Finished\" sound name \"Glass\""
}
